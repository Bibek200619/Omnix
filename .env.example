# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Operational
ENV=dev
DEV_MODE=true
REDIS_URL=redis://localhost:6379/0

# File storage
# Local storage is suitable for development only. Production must use shared
# object storage or an explicitly mounted shared volume; never set this flag
# to true without providing that shared storage to every API and worker replica.
OMNIX_FILE_STORAGE_BACKEND=local
OMNIX_UPLOAD_DIR=./uploads
OMNIX_FILE_STORAGE_SHARED=false
OMNIX_FILE_STORAGE_BUCKET=omnix-files

# AI Runtime
MODEL_URL=http://localhost:11434/v1/chat/completions
AI_MODEL=phi3:latest
AI_REQUEST_TIMEOUT_SECONDS=60
AI_STREAM_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=256
AI_MAX_CONTEXT_MESSAGES=8
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=phi3:latest
SIMILARITY_THRESHOLD=1.5
HYBRID_TOP_K=3
HYBRID_POOL_SIZE=6
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_SNIPPET_MAX_CHARS=700
WEB_SEARCH_DEPTH=basic

# Observability
ENABLE_TRACING=true
ENABLE_METRICS=true
TRACING_EXPORTER=console
