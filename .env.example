# Supabase
SUPABASE_URL=NEXT_PUBLIC_SUPABASE_URL_REDACTED
SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_REDACTED
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_REDACTED

# Operational
ENV=dev
DEV_MODE=true
REDIS_URL=redis://localhost:6379/0

# AI Runtime
MODEL_URL=http://localhost:11434/v1/chat/completions
AI_MODEL=gemma:2b
AI_REQUEST_TIMEOUT_SECONDS=60
AI_STREAM_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=900
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma:2b
SIMILARITY_THRESHOLD=1.5

# Observability
ENABLE_TRACING=true
ENABLE_METRICS=true
TRACING_EXPORTER=console
