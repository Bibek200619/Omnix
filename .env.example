# Supabase
SUPABASE_URL=NEXT_PUBLIC_SUPABASE_URL_REDACTED
SUPABASE_ANON_KEY=NEXT_PUBLIC_SUPABASE_ANON_KEY_REDACTED
SUPABASE_SERVICE_ROLE_KEY=SUPABASE_SERVICE_ROLE_KEY_REDACTED

# Operational
ENV=dev
DEV_MODE=true
REDIS_URL=redis://localhost:6379/0

# AI Runtime
MODEL_URL=http://localhost:11434/v1/chat/completions
AI_MODEL=phi3:latest
AI_REQUEST_TIMEOUT_SECONDS=60
AI_STREAM_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=256
AI_MAX_CONTEXT_MESSAGES=8
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=phi3:latest
SIMILARITY_THRESHOLD=1.5
HYBRID_TOP_K=3
HYBRID_POOL_SIZE=6
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_SNIPPET_MAX_CHARS=700
WEB_SEARCH_DEPTH=basic

# Observability
ENABLE_TRACING=true
ENABLE_METRICS=true
TRACING_EXPORTER=console
