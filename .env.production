# .env.production - Production Environment Variables

# Environment
ENV=production
DEV_MODE=false

# Supabase Configurations (Mandatory)
SUPABASE_URL=https://your-production-project.supabase.co
SUPABASE_ANON_KEY=your_production_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key

# Redis (Upstash or ElastiCache)
REDIS_URL=rediss://default:your-upstash-password@your-upstash-endpoint.upstash.io:6379

# AI Model Provider
MODEL_URL=http://localhost:11434/v1/chat/completions
AI_MODEL=phi3:latest
AI_REQUEST_TIMEOUT_SECONDS=60
AI_STREAM_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=256
AI_MAX_CONTEXT_MESSAGES=8
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=phi3:latest

# Public API endpoint used by Vercel / browser clients.
NEXT_PUBLIC_API_BASE_URL=OMNIX_API_PROXY_TARGET_REDACTED

# Retrieval Configuration
SIMILARITY_THRESHOLD=1.5
HYBRID_TOP_K=3
HYBRID_POOL_SIZE=6

# Observability
ENABLE_TRACING=true
ENABLE_METRICS=true
TRACING_EXPORTER=otlp
# OTLP_ENDPOINT=https://otlp.datadoghq.com

# Worker Configurations
WORKER_COUNT=4
STREAMING_TIMEOUT=60.0
